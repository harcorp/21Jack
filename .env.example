# Copy to .env (never commit .env)
# Leave empty to use embedded PGlite under .data/<service> (no Neon needed locally)
DATABASE_URL=

# Shared secret for server-to-server calls (web -> game/engine, game -> engine)
SERVICE_KEY=change-me

# Signs the web session cookie
SESSION_SECRET=change-me-too

WEB_PORT=3000
GAME_PORT=3001
ENGINE_PORT=3002
GAME_URL=http://localhost:3001
ENGINE_URL=http://localhost:3002

# mock = in-memory engine client inside apps/game, real = call ENGINE_URL
ENGINE_MODE=real
